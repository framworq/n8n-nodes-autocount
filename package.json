{
  "name": "n8n-nodes-autocount",
  "version": "0.1.0",
  "description": "n8n community node for AutoCount Cloud Accounting (Malaysia): customers, suppliers, products, sales and purchase documents, payments, journals and stock, plus a polling trigger.",
  "license": "MIT",
  "homepage": "https://github.com/framworq/n8n-nodes-autocount#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "autocount",
    "autocount cloud accounting",
    "accounting",
    "malaysia",
    "e-invoice",
    "myinvois"
  ],
  "author": {
    "name": "Framworq",
    "email": "john@framworq.com",
    "url": "https://framworq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framworq/n8n-nodes-autocount.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "n8n-node lint && n8n-node build",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AutoCountApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AutoCount/AutoCount.node.js",
      "dist/nodes/AutoCount/AutoCountTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.53.3",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/framworq/n8n-nodes-autocount/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
